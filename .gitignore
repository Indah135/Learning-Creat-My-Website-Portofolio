# ============================================================
# LOGS — File log otomatis dari berbagai tools
# ============================================================
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ============================================================
# DEPENDENSI & BUILD — Tidak perlu di-commit
# ============================================================
node_modules
dist
dist-ssr
*.local

# ============================================================
# EVIRONMENT VARIABLES — Berisi kredensial rahasia
# Buat file .env.example (tanpa nilai asli) sebagai panduan
# ============================================================
.env
.env.*
!.env.example

# ============================================================
# BACKEND PHP — Seluruh folder API & database
# Mengandung: koneksi database, query SQL, logika server
# ============================================================
api/
database/
*.sql

# File PHP sensitif di root (sudah dihapus, tapi tetap dijaga)
koneksi.php
hash.php

# ============================================================
# FOTO & ASET PRIBADI
# ============================================================
public/cv.pdf
public/*.pdf
docs/cv.pdf
docs/*.pdf

# ============================================================
# AREA ADMIN REACT — Halaman khusus pemilik
# Mengandung: form login, dashboard pengelolaan data
# ============================================================
src/admin/

# ============================================================
# FILE KEAMANAN & SERTIFIKAT — Kunci enkripsi & SSL
# ============================================================
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx

# ============================================================
# EDITOR & SISTEM OPERASI — File konfigurasi lokal
# ============================================================
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
